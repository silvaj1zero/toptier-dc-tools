---
import '@/styles/fonts.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Marca a página como ferramenta (emite JSON-LD WebApplication). */
  tool?: boolean;
}

const { title, description, tool = false } = Astro.props;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const currentPath = Astro.url.pathname;

// Umami — mesmo padrão do site institucional (toptier.net.br): site-ID por
// env PUBLIC_* (build-time); a AUSÊNCIA da env OMITE a tag em vez de apontar
// para um ID inventado. Website separado no mesmo projeto Umami Cloud do
// site principal — dashboards distintos, sem misturar métricas dos dois
// domínios. [Story M3 — Nível 2a da integração Top Tools]
// `.trim()`: um id salvo com quebra de linha no painel de env vai parar no
// atributo HTML com o `\n` junto, e o coletor do Umami responde 400 — o script
// carrega, a página parece certa e NADA é gravado. Aconteceu em 25/08.
const UMAMI_WEBSITE_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
if (!UMAMI_WEBSITE_ID && import.meta.env.PROD) {
  console.warn(
    '[Base] PUBLIC_UMAMI_WEBSITE_ID ausente no build de produção — script Umami OMITIDO. ' +
      'Configure a env no projeto Vercel (Settings → Environment Variables).',
  );
}

/* As 6 ferramentas e as 2 páginas de apoio eram 8 itens de primeiro nível numa
   linha só. No desktop a barra quebrava em duas linhas; em 390 px virava um muro
   de nove links ocupando ~45% da primeira tela, empurrando o conteúdo para baixo
   da dobra. Agora as ferramentas vivem sob um item único e o celular tem menu de
   verdade. [Onda 1 2026-08-25] */
const FERRAMENTAS = [
  { href: '/calculadora-pue/', label: 'Calculadora PUE' },
  { href: '/simulador-economia/', label: 'Simulador de Economia' },
  { href: '/calculadora-virtualizacao/', label: 'Virtualização' },
  { href: '/modelador-pue/', label: 'Modelador de PUE' },
  { href: '/planejador-densidade/', label: 'Espaço & Densidade' },
  { href: '/maturidade-operacional/', label: 'Maturidade (FOMM)' },
];

const APOIO = [
  { href: '/como-usar/', label: 'Como usar' },
  { href: '/metodologia/', label: 'Metodologia' },
];

/** O rodapé lista as ferramentas — mesma fonte, para não divergirem. */
const NAV = [...FERRAMENTAS, ...APOIO];
const emFerramenta = FERRAMENTAS.some((f) => f.href === currentPath);

const organizationLd = {
  '@type': 'Organization',
  '@id': 'https://www.toptier.net.br/#org',
  name: 'Top Tier Infrastructure',
  url: 'https://www.toptier.net.br',
  logo: new URL('/logo-tti.webp', Astro.site).href,
  email: 'contato@toptier.net.br',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationLd,
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: `${Astro.site}`,
      name: 'Top Tools · Top Tier Infrastructure',
      inLanguage: 'pt-BR',
      publisher: { '@id': 'https://www.toptier.net.br/#org' },
    },
    ...(tool
      ? [
          {
            '@type': 'WebApplication',
            name: title,
            description,
            url: canonical.href,
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web',
            inLanguage: 'pt-BR',
            isAccessibleForFree: true,
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
            provider: { '@id': 'https://www.toptier.net.br/#org' },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Top Tools · Top Tier Infrastructure</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Top Tools · Top Tier Infrastructure" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Top Tools — ferramentas abertas de eficiência energética para data centers"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {UMAMI_WEBSITE_ID && (
      <script defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} />
    )}
    <script is:inline>
      // Resolve o tema antes do primeiro paint (evita flash). Escolha manual > sistema.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('tt-theme');
        } catch {}
        const theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          <img
            class="brand-logo logo-light"
            src="/logo-tti.webp"
            alt="Top Tier Infrastructure"
            width="146"
            height="34"
            decoding="async"
          />
          <img
            class="brand-logo logo-dark"
            src="/logo-tti-dark.webp"
            alt=""
            aria-hidden="true"
            width="146"
            height="34"
            decoding="async"
          />
          <span class="brand-name">Top <em>Tools</em></span>
        </a>
        <nav class="nav-desktop" aria-label="Principal">
          <details class="nav-drop" data-menu>
            <summary aria-haspopup="true">
              <span class:list={['nav-drop-rotulo', emFerramenta && 'esta-aqui']}>Ferramentas</span>
              <svg
                class="nav-chevron"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div class="nav-drop-painel">
              {FERRAMENTAS.map((item) => (
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
          {APOIO.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href="https://www.toptier.net.br" target="_blank" rel="noopener noreferrer">
            toptier.net.br<span class="sr-only"> (abre em nova aba)</span>
          </a>
        </nav>

        <div class="header-acoes">
          <details class="nav-mobile" data-menu>
            <summary aria-label="Abrir menu de navegação">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
              </svg>
            </summary>
            <div class="nav-mobile-painel">
              <p class="nav-mobile-titulo">Ferramentas</p>
              {FERRAMENTAS.map((item) => (
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
              <p class="nav-mobile-titulo">Entender o método</p>
              {APOIO.map((item) => (
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
              <a
                class="nav-mobile-externo"
                href="https://www.toptier.net.br"
                target="_blank"
                rel="noopener noreferrer"
              >
                toptier.net.br<span class="sr-only"> (abre em nova aba)</span>
              </a>
            </div>
          </details>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Alternar tema claro/escuro"
            aria-pressed="false"
            title="Alternar tema claro/escuro"
          >
            <svg
              class="icon-moon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <svg
              class="icon-sun"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner footer-grid">
        <div>
          <p class="footer-title">Ferramentas</p>
          <ul class="footer-links">
            {NAV.slice(0, 6).map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="footer-title">Confiança</p>
          <ul class="footer-links">
            <li><a href="/metodologia/">Metodologia aberta</a></li>
            <li>Métricas ISO/IEC 30134 · The Green Grid</li>
            <li>Benchmarks Uptime Institute 2025</li>
            <li>Engines validados e testados — fórmulas expostas</li>
          </ul>
        </div>
        <div>
          <p class="footer-title">Top Tier Infrastructure®</p>
          <ul class="footer-links">
            <li>Mais de 25 anos em missão crítica</li>
            <li>
              <a href="https://www.toptier.net.br" rel="noopener noreferrer" target="_blank"
                >toptier.net.br<span class="sr-only"> (abre em nova aba)</span></a
              >
            </li>
            <li><a href="mailto:contato@toptier.net.br">contato@toptier.net.br</a></li>
          </ul>
        </div>
      </div>
      <div class="inner footer-legal">
        © {year} Top Tier Infrastructure®. Ferramentas educacionais — resultados são estimativas e
        não substituem medição em campo nem parecer de engenharia. Usamos analytics cookieless
        (Umami) — sem cookies de rastreamento. Veja a{' '}
        <a href="https://www.toptier.net.br/privacidade">Política de Privacidade</a>.
      </div>
    </footer>
    <script is:inline>
      // Menus: o <details> já abre, fecha e responde ao teclado sozinho. Isto
      // acrescenta só o que ele não dá — sair com Esc e ao clicar fora, que é o
      // que um menu aberto precisa para não ficar preso na tela.
      (() => {
        const menus = document.querySelectorAll('[data-menu]');
        if (!menus.length) return;
        const fechar = (exceto) =>
          menus.forEach((m) => {
            if (m !== exceto) m.open = false;
          });
        document.addEventListener('click', (e) => {
          const dentro = e.target.closest('[data-menu]');
          fechar(dentro);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const aberto = document.querySelector('[data-menu][open]');
          if (!aberto) return;
          aberto.open = false;
          // Devolve o foco ao gatilho: sem isso, fechar com Esc joga o foco
          // para o começo da página e o teclado perde o lugar.
          aberto.querySelector('summary')?.focus();
        });
      })();

      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const sync = () =>
          btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
        sync();
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('tt-theme', next);
          } catch {}
          sync();
        });
      })();
    </script>
  </body>
</html>
