---
import Base from '@/layouts/Base.astro';
import LeadForm from '@/components/LeadForm';
---

<Base
  title="Ferramentas de Eficiência Energética para Data Centers"
  description="Liderança em eficiência e operação de missão crítica: calculadoras abertas de PUE, economia, virtualização, projeto e densidade, pré-diagnóstico de maturidade operacional (FOMM) e o caminho até a auditoria e certificação. Por Top Tier Infrastructure — 30+ anos em missão crítica."
>
  <section class="hero">
    <div>
      <h1>Liderança em eficiência e operação de data centers de missão crítica</h1>
      <p class="hero-sub">
        Ferramentas abertas, capacitação e auditoria pela <strong>Top Tier Infrastructure®</strong>:
        meça seu PUE, avalie a maturidade da sua operação e compare com os benchmarks de 2025,
        com <strong>fórmula, fator e fonte na própria página</strong>.
      </p>
      <p class="hero-ctas">
        <a class="btn" href="/maturidade-operacional/">Avaliar minha operação (FOMM)</a>
        <a class="btn-ghost" href="#ferramentas">Explorar as ferramentas</a>
      </p>
    </div>
    <ul class="hero-proof" aria-label="Por que confiar">
      <li><strong>Metodologia aberta</strong> — nenhum número sem fonte, nenhuma fórmula oculta</li>
      <li><strong>Engines validados</strong> — 610 pontos de referência conferidos contra a ferramenta original, todos batendo</li>
      <li><strong>Benchmarks 2025</strong> — Uptime Institute, ISO/IEC 30134, dados brasileiros ANEEL/MCTI</li>
    </ul>
  </section>

  <section aria-label="Credenciais Top Tier">
    <div class="stat-grid">
      <div class="stat">
        <div class="label">Experiência</div>
        <div class="value">30+ anos</div>
        <div class="note">liderando operações de missão crítica</div>
      </div>
      <div class="stat">
        <div class="label">Confiabilidade</div>
        <div class="value">Zero Outage</div>
        <div class="note">programa de excelência (IBM)</div>
      </div>
      <div class="stat">
        <div class="label">Eficiência</div>
        <div class="value">DCEP</div>
        <div class="note">parceira do programa US DOE</div>
      </div>
      <div class="stat">
        <div class="label">Certificação</div>
        <div class="value">FOMM · ICOR</div>
        <div class="note">auditoria independente</div>
      </div>
    </div>
  </section>

  <section aria-labelledby="jornada-titulo">
    <h2 id="jornada-titulo">Da medição à excelência operacional</h2>
    <p>
      As ferramentas são o primeiro passo. Depois vêm avaliação, auditoria e evolução
      contínua, com a Top Tier acompanhando cada etapa.
    </p>
    <div class="journey" tabindex="0">
      <svg
        viewBox="0 0 1180 264"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Jornada em quatro passos: 1 meça e planeje com as ferramentas abertas; 2 avalie a operação com o pré-diagnóstico FOMM; 3 audite com a Top Tier rumo à certificação via ICOR Internacional; 4 opere com excelência com consultoria e capacitação contínua."
      >
        <defs>
          <marker id="jarr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0 0 L10 5 L0 10 z" fill="var(--tt-teal-600)"></path>
          </marker>
        </defs>

        <g font-family="inherit">
          <rect x="8" y="24" width="260" height="216" rx="10" fill="var(--tt-card)" stroke="var(--tt-gray-300)"></rect>
          <text x="28" y="58" font-size="12" letter-spacing="1.5" font-weight="700" fill="var(--tt-teal-600)">PASSO 1</text>
          <text x="28" y="86" font-size="17" font-weight="700" fill="var(--tt-navy-900)">Meça e planeje</text>
          <text x="28" y="116" font-size="13" fill="var(--tt-gray-700)">Calculadoras abertas de PUE,</text>
          <text x="28" y="136" font-size="13" fill="var(--tt-gray-700)">economia, virtualização, projeto</text>
          <text x="28" y="156" font-size="13" fill="var(--tt-gray-700)">e densidade — fórmulas expostas,</text>
          <text x="28" y="176" font-size="13" fill="var(--tt-gray-700)">gratuitas e sem cadastro.</text>

          <rect x="312" y="24" width="260" height="216" rx="10" fill="var(--tt-teal-100)" stroke="var(--tt-teal-600)" stroke-width="1.5"></rect>
          <text x="332" y="58" font-size="12" letter-spacing="1.5" font-weight="700" fill="var(--tt-teal-600)">PASSO 2</text>
          <text x="332" y="86" font-size="17" font-weight="700" fill="var(--tt-navy-900)">Avalie a operação</text>
          <text x="332" y="116" font-size="13" fill="var(--tt-gray-700)">Pré-Diagnóstico FOMM: as 7</text>
          <text x="332" y="136" font-size="13" fill="var(--tt-gray-700)">disciplinas da operação na escala</text>
          <text x="332" y="156" font-size="13" fill="var(--tt-gray-700)">1–5, radar de maturidade e gaps</text>
          <text x="332" y="176" font-size="13" fill="var(--tt-gray-700)">prioritários em ~10 minutos.</text>

          <rect x="616" y="24" width="260" height="216" rx="10" fill="var(--tt-card)" stroke="var(--tt-gray-300)"></rect>
          <text x="636" y="58" font-size="12" letter-spacing="1.5" font-weight="700" fill="var(--tt-teal-600)">PASSO 3</text>
          <text x="636" y="86" font-size="17" font-weight="700" fill="var(--tt-navy-900)">Audite e certifique</text>
          <text x="636" y="116" font-size="13" fill="var(--tt-gray-700)">Diagnóstico de prontidão e</text>
          <text x="636" y="136" font-size="13" fill="var(--tt-gray-700)">auditoria FOMM com a Top Tier,</text>
          <text x="636" y="156" font-size="13" fill="var(--tt-gray-700)">rumo à certificação via ICOR</text>
          <text x="636" y="176" font-size="13" fill="var(--tt-gray-700)">Internacional.</text>

          <rect x="920" y="24" width="252" height="216" rx="10" fill="var(--tt-card)" stroke="var(--tt-gray-300)"></rect>
          <text x="940" y="58" font-size="12" letter-spacing="1.5" font-weight="700" fill="var(--tt-teal-600)">PASSO 4</text>
          <text x="940" y="86" font-size="17" font-weight="700" fill="var(--tt-navy-900)">Opere com excelência</text>
          <text x="940" y="116" font-size="13" fill="var(--tt-gray-700)">Consultoria e capacitação</text>
          <text x="940" y="136" font-size="13" fill="var(--tt-gray-700)">contínua do seu time, com score</text>
          <text x="940" y="156" font-size="13" fill="var(--tt-gray-700)">e software proprietários</text>
          <text x="940" y="176" font-size="13" fill="var(--tt-gray-700)">(TierScope).</text>

          <line x1="272" y1="132" x2="306" y2="132" stroke="var(--tt-teal-600)" stroke-width="2.5" marker-end="url(#jarr)"></line>
          <line x1="576" y1="132" x2="610" y2="132" stroke="var(--tt-teal-600)" stroke-width="2.5" marker-end="url(#jarr)"></line>
          <line x1="880" y1="132" x2="914" y2="132" stroke="var(--tt-teal-600)" stroke-width="2.5" marker-end="url(#jarr)"></line>
        </g>
      </svg>
    </div>
  </section>

  <section id="ferramentas" aria-labelledby="ferramentas-titulo">
    <h2 id="ferramentas-titulo">As ferramentas — gratuitas e com metodologia aberta</h2>
    <div class="tool-grid">
      <div class="card">
        <h3><a href="/calculadora-pue/">Calculadora de PUE</a></h3>
        <p>
          Calcule PUE e DCiE conforme ISO/IEC 30134-2, compare com os benchmarks de 2025 (média
          global 1,54 — Uptime Institute) e estime o custo anual em reais com bandeira tarifária.
          WUE, CUE e leitura regulatória (EnEfG/EED) inclusas.
        </p>
        <a class="btn" href="/calculadora-pue/">Calcular meu PUE</a>
      </div>

      <div class="card">
        <h3><a href="/simulador-economia/">Simulador de Economia de Energia</a></h3>
        <p>
          Projete a economia em kWh, reais e toneladas de CO2e ao reduzir o PUE, em horizontes de
          1, 5 e 10 anos, com o grid brasileiro e medidas típicas para cada faixa de ganho.
        </p>
        <a class="btn" href="/simulador-economia/">Simular economia</a>
      </div>

      <div class="card">
        <h3><a href="/calculadora-virtualizacao/">Calculadora de Virtualização</a></h3>
        <p>
          Simule a consolidação de servidores e o efeito no PUE e na conta anual — incluindo o
          paradoxo do PUE. Reconstrução aberta do TradeOff Tool descontinuado da Schneider (White
          Paper 118), com validação empírica em 311 instalações.
        </p>
        <a class="btn" href="/calculadora-virtualizacao/">Simular consolidação</a>
      </div>

      <div class="card">
        <h3><a href="/modelador-pue/">Modelador de PUE de Projeto</a></h3>
        <p>
          Estime o PUE a partir das decisões de arquitetura — UPS, redundância, climatização,
          economizador e 13 detalhes de projeto — com curva PUE × carga e até 4 cenários lado a
          lado. Réplica aberta e validada ponto a ponto (610/610).
        </p>
        <a class="btn" href="/modelador-pue/">Modelar meu projeto</a>
      </div>

      <div class="card">
        <h3><a href="/planejador-densidade/">Planejador de Espaço e Densidade</a></h3>
        <p>
          Especifique espaço e densidade sem o "W/m² solto" que encalha capacidade: da potência por
          gabinete à instalação inteira (gabinete → pod → sala → instalação), pelo método aberto do
          White Paper #155 da Schneider.
        </p>
        <a class="btn" href="/planejador-densidade/">Planejar capacidade</a>
      </div>

      <div class="card highlight-card">
        <h3><a href="/maturidade-operacional/">Pré-Diagnóstico de Maturidade Operacional (FOMM)</a></h3>
        <p>
          Em ~10 minutos, avalie sua operação nas 7 disciplinas do Facility Operations Maturity
          Model (Schneider WP #197): perfil na escala 1–5, radar de maturidade e os três gaps
          prioritários. O primeiro passo da jornada de auditoria da Top Tier — rumo às
          certificações FOMM do ICOR Internacional.
        </p>
        <a class="btn" href="/maturidade-operacional/">Fazer o pré-diagnóstico</a>
      </div>
    </div>

    <div class="card soft">
      <h3><a href="/como-usar/">Não sabe por onde começar?</a></h3>
      <p>
        O guia <a href="/como-usar/">Como usar as ferramentas</a> traz três roteiros prontos por
        objetivo — custo da ineficiência, projeto/expansão e maturidade da operação — com o passo
        a passo de cada ferramenta em 5 a 20 minutos.
      </p>
    </div>

    <div class="card soft">
      <h3><a href="/metodologia/">Metodologia aberta</a></h3>
      <p>
        Calculadoras clássicas do mercado trazem tarifas de 2010, benchmarks obsoletos e fatores
        que você não consegue inspecionar. Aqui estão as normas, os benchmarks e as decisões
        metodológicas de cada ferramenta.
      </p>
    </div>
  </section>

  <section aria-labelledby="pilares-titulo">
    <h2 id="pilares-titulo">Liderança, capacitação e expertise</h2>
    <div class="tool-grid">
      <div class="card">
        <h3>Liderança</h3>
        <p>
          Mais de 30 anos à frente de operações de missão crítica — data centers, bancos, telecom e
          indústria — com o programa Zero Outage (IBM) e parceria no programa DCEP do US DOE.
        </p>
      </div>
      <div class="card">
        <h3>Capacitação</h3>
        <p>
          Formação e treinamento de times de operação com a mesma metodologia aberta das
          ferramentas: cada fórmula, critério e benchmark aberto, para o seu time verificar o
          cálculo e não só receber o número.
        </p>
      </div>
      <div class="card">
        <h3>Expertise</h3>
        <p>
          Metodologia exclusiva de auditoria com score e software proprietários (TierScope),
          engines validados ponto a ponto contra as ferramentas clássicas do mercado e o caminho
          até as certificações FOMM via ICOR Internacional.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="paraquem-titulo">
    <h2 id="paraquem-titulo">Para quem é</h2>
    <div class="tool-grid">
      <div class="card soft">
        <h3>Operadores de data center</h3>
        <p>
          Colocation, edge ou salas próprias: saiba onde sua operação está frente aos benchmarks
          de 2025, quanto custa cada décimo de PUE e onde estão os gaps de maturidade.
        </p>
      </div>
      <div class="card soft">
        <h3>Empresas de missão crítica</h3>
        <p>
          Bancos, saúde, telecom e indústria: infraestrutura crítica exige operação madura e
          auditável. Avalie disciplina por disciplina e leve à diretoria um plano com números.
        </p>
      </div>
      <div class="card soft">
        <h3>Times de projeto e engenharia</h3>
        <p>
          Modele o PUE das decisões de arquitetura antes de construir, dimensione espaço e
          densidade sem capacidade encalhada e defenda o projeto com fórmulas que qualquer auditor
          pode conferir.
        </p>
      </div>
    </div>
  </section>

  <LeadForm client:visible title="Fale com um especialista em missão crítica" />
</Base>

<style>
  section {
    margin-top: 2.5rem;
  }

  section:first-of-type {
    margin-top: 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1rem;
  }

  .tool-grid :global(.card) {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .tool-grid :global(.card p) {
    flex: 1;
  }

  .tool-grid :global(.card .btn) {
    align-self: flex-start;
  }

  .highlight-card {
    border-color: var(--tt-teal-600);
    background: var(--tt-teal-100);
  }

  /* Diagrama da jornada — rola horizontal no mobile, nunca estoura a página */
  .journey {
    overflow-x: auto;
    border: 1px solid var(--tt-gray-300);
    border-radius: var(--tt-radius);
    background: var(--tt-bg-soft);
    padding: 0.75rem;
  }

  .journey svg {
    display: block;
    min-width: 980px;
    width: 100%;
    height: auto;
    font-family: var(--tt-font);
  }
</style>
